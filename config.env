TEXT_API_PROVIDER=doubao # 文本生成提供方：doubao 表示豆包，openai 表示 OpenAI 文本模型
DOUBAO_TEXT_MODEL=doubao-seed-2-0-mini-260428 # 豆包主文本模型 ID；可替换成你要测试的新文本模型
TEXT_REQUEST_RETRY_COUNT=3 # 文本生成最多尝试 3 次；超时会重试，内容校验异常也会重新调用，超过后直接终止
DOUBAO_REVIEW_MODEL=doubao-seed-2-0-mini-260428 # 多版本图片评审模型；tools/select_publish_images.py 会优先读取这里，未配置时回退到 DOUBAO_TEXT_MODEL
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3 # 豆包 OpenAI 兼容接口地址；通常不用改
DOUBAO_TEXT_TEMPERATURE=0.2 # 豆包文本温度；越低越稳定，越高越发散
PUBLISH_AUTO_SELECT=1 # 主流程在整套图片和 Photoshop 完成后是否自动创建 publish 并筛选发布图：1 开启，2 关闭
PUBLISH_TITLE_CENTER_RETRY_LIMIT=3 # 首图/图解页若当前候选全部未通过标题居中硬门槛，按原 prompt 自动补生几轮单图再复评
PUBLISH_REQUIRED_TOPICS=十万个吃什么 # 抖音图文描述最终 5 个标签里必须优先带上的手动话题；多个可用空格、逗号、分号或换行分隔，写不写 # 都可以
PUBLISH_REQUIRED_TOPICS_XIAOHONGSHU= # 小红书话题必带项；留空表示不强制；多个可用空格、逗号、分号或换行分隔
PUBLISH_REQUIRED_TOPICS_WECHAT= # 微信视频号和公众号话题必带项；留空表示不强制；多个可用空格、逗号、分号或换行分隔
PUBLISH_REQUIRED_TOPICS_KUAISHOU= # 快手话题必带项；留空表示不强制；多个可用空格、逗号、分号或换行分隔

AUTO_GENERATE_DISH_IDEA=1 # 是否先让 AI 自动生成 dish_name.txt：1 开启，0 关闭；默认建议保持 1
AUTO_DISH_CUISINE_MODE=1 # 自动造菜的参考菜系：0 全部随机，1 中餐，2 新马泰/东南亚，3 日韩，4 西餐/欧洲，5 中东北非，6 东欧，7 拉美
AUTO_DISH_LIBRARY_FILE=chuantongcaipu.txt # 自动抽取传统参考菜的菜库文件；默认就是项目根目录下的 chuantongcaipu.txt
AUTO_DISH_MEMORY_FILE=dish_idea_memory.jsonl # 自动造菜记忆文件；会记录已用参考菜和已生成新菜名，默认不用改

OPENAI_TEXT_MODEL=gpt-4.1-mini # 仅在 TEXT_API_PROVIDER=openai 时生效的主文本模型
OPENAI_TEXT_TEMPERATURE=0.3 # OpenAI 文本温度；越低越稳定，越高越发散

OPENAI_REQUEST_TIMEOUT_SECONDS=900 # OpenAI 客户端总超时时间，单位秒
OPENAI_TEXT_REQUEST_TIMEOUT_SECONDS=120 # 文本生成超时时间，单位秒；当前实测豆包文本阶段返回在 12 到 45 秒，120 秒已留出足够余量
OPENAI_IMAGE_REQUEST_TIMEOUT_SECONDS=900 # 图片生成超时时间，单位秒

OPENAI_IMAGE_MODEL=gpt-image-2-2026-04-21 # 首图与通用生图模型 ID；当前官方 GPT Image 2 最新快照；若想自动跟随官方默认可改成 gpt-image-2
OPENAI_IMAGE_SIZE=1024x1536 # 首图默认尺寸；竖版 2:3
OPENAI_IMAGE_QUALITY=high # 首图默认质量：low / medium / high / auto；medium 比 high 便宜很多，适合当前性价比方案
OPENAI_IMAGE_COUNT=2 # 首图一次生成几张图；常用 1 或 2；数量越大成本越高，也会按图片张数占用 IPM

OPENAI_TUJIE_IMAGE_MODEL=gpt-image-2-2026-04-21 # 图解02到图解06使用的图片模型 ID；若想自动跟随官方默认可改成 gpt-image-2
OPENAI_TUJIE_IMAGE_SIZE=1024x1536 # 图解02到图解06默认尺寸；竖版 2:3
OPENAI_TUJIE_IMAGE_QUALITY=medium # 图解02到图解06默认质量：low / medium / high / auto；当前默认改为 medium 提高性价比
OPENAI_TUJIE_IMAGE_COUNT=3 # 每张图解页一次生成几张图；通常设 1；数量越大成本越高，也会按图片张数占用 IPM

OPENAI_COVER_IMAGE_MODEL=gpt-image-2-2026-04-21 # 封面图使用的图片模型 ID；若想自动跟随官方默认可改成 gpt-image-2
OPENAI_COVER_IMAGE_SIZE=1024x1536 # 封面图默认尺寸；竖版 2:3；与图解页保持一致，避免封面单独走更高更窄的长竖版
OPENAI_COVER_IMAGE_QUALITY=medium # 封面图默认质量：low / medium / high / auto；当前默认改为 medium 提高性价比
OPENAI_COVER_IMAGE_COUNT=2 # 封面图一次生成几张图；通常设 1；数量越大成本越高，也会按图片张数占用 IPM

PHOTOSHOP_AUTO_COMPOSITE=1 # 主流程图片全部生成后是否自动套 PSD 模板并覆盖导出 JPG：1 开启，2 关闭
PHOTOSHOP_LOCAL_EXE=D:\Program Files\Photoshop\App\Program Files\Adobe\Adobe Photoshop 2026\Photoshop.exe # 本地 Photoshop.exe 路径；运行主流程前请先关闭 Photoshop
PHOTOSHOP_TEMPLATE_FILE=tools/photoshop_template/template.psd # 主流程和工具脚本共用的 PSD 模板路径
PHOTOSHOP_TEMPLATE_SMART_OBJECT_LAYER=input_image # PSD 模板里承接 AI 图片的智能对象层名称
PHOTOSHOP_JPEG_QUALITY=12 # Photoshop 导出 JPG 的质量；支持 1 到 12
PHOTOSHOP_JOB_TIMEOUT_SECONDS=900 # 单张图片等待 Photoshop 完成的最长秒数