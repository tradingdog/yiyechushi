TEXT_API_PROVIDER=doubao # 文本生成提供方：doubao 或 openai。V2 首功能默认使用豆包
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3 # 豆包 OpenAI 兼容地址
DOUBAO_TEXT_MODEL=doubao-seed-2-0-pro-260215 # 豆包文本模型（Seed 2.0 Pro 旗舰）
MODEL_TEMPERATURE=0.3 # 模型温度（自动造菜 + 模板重写共用）
DOUBAO_TEXT_TEMPERATURE=0.3 # 兼容旧参数；未设置 MODEL_TEMPERATURE 时才会读取这里
TEXT_REQUEST_TIMEOUT_SECONDS=120 # 豆包文本请求超时（秒）
TEXT_REQUEST_RETRY_COUNT=5 # 豆包文本请求重试次数（连接/500 等可重试错误带退避）
HTTP_TRUST_ENV=1 # 是否继承系统代理环境变量：1 继承，0 不继承（与 V1 保持一致，默认 1）

V2_WORKFLOW_MODE=mode2 # 流程模式：mode2（海报/细节/菜谱/封面四组图，默认）或 mode1（主图+封面）
AUTO_GENERATE_DISH_IDEA=1 # 1 自动造菜并写回 V2/dish_name.txt；0 读取手动 dish_name.txt
AUTO_DISH_RETRY_COUNT=3 # 自动造菜失败重试次数
AUTO_DISH_CUISINE_MODE=1 # 自动造菜菜系：0随机全菜系，1中华料理，2新马泰，3日韩，4西餐，5中东北非，6东欧，7拉美
AUTO_DISH_LIBRARY_FILE=chuantongcaipu.txt # 传统菜库文件（相对仓库根目录）
AUTO_DISH_INGREDIENT_LIBRARY_FILE=V2/cankao/zhushicai.txt # 菜市场食材库；主食材必须来自此库
AUTO_DISH_MEMORY_FILE=V2/dish_idea_memory.jsonl # V2 自动造菜历史记忆文件
CONTENT_TRACK=电饭煲一锅出 # 三图内容赛道，影响豆包输出脚本风格

OPENAI_IMAGE_MODEL=gpt-image-2 # 文生图模型，默认 gpt-image-2
IMAGE_API_PROVIDER=official # 生图渠道：official（官方 api.openai.com + OPENAIOFFICIAL_API_KEY）或 silkroad（丝路网关）
IMAGE_ASPECT_RATIO=2:3 # 生图比例，与顶栏选项一致
IMAGE_RESOLUTION_TIER=1k # 分辨率档位：1k / 2k / 4k（丝路仅 1k）
OPENAI_BASE_URL=https://ai.silkroadai.io/v1 # 丝路 OpenAI 兼容网关；官方渠道时忽略
OPENAI_IMAGE_SIZE=1024x1536 # 图片尺寸，竖版 2:3
OPENAI_IMAGE_QUALITY=high # 图片质量：low / medium / high / auto
OPENAI_IMAGE_COUNT=2 # 一次生成图片数量，默认 1
COVER_IMAGE_COUNT=2 # 一次生成封面数量（会对封面评分后选优到 publish）
MODE2_POSTER_IMAGE_QUALITY=high # 模式2 海报图画质
MODE2_POSTER_IMAGE_COUNT=2 # 模式2 海报图数量
MODE2_DETAIL_IMAGE_QUALITY=high # 模式2 细节图画质
MODE2_DETAIL_IMAGE_COUNT=1 # 模式2 细节图数量
MODE2_RECIPE_IMAGE_QUALITY=high # 模式2 菜谱图画质
MODE2_RECIPE_IMAGE_COUNT=1 # 模式2 菜谱图数量
MODE2_COVER_IMAGE_QUALITY=high # 模式2 封面图画质
MODE2_COVER_IMAGE_COUNT=1 # 模式2 封面图数量
OPENAI_IMAGE_REQUEST_TIMEOUT_SECONDS=900 # 生图超时（秒）
IMAGE_REQUEST_RETRY_COUNT=3 # 生图最多尝试次数（含首次）；未达 n 张或 502/连接错误等可重试错误会自动重试
